{
  "manifest_version": 3,
  "name": "GitHub Network Ninja",
  "version": "1.2.0",
  "description": "改进 GitHub Network Graph：可切换全屏 + 可搜索提交列表",
  "content_scripts": [
    {
      "matches": ["https://github.com/*/*/network"],
      "js": ["page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://github.com/*/*/network"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://github.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
